<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #e8f0fe;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.bai_tap_lon.controller.SellerController">

    <!-- ══ TOP HEADER BAR ═══════════════════════════════════════ -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #0277bd, #01579b);                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.22), 12, 0, 0, 4);">
            <padding>
                <Insets bottom="16.0" left="28.0" right="28.0" top="16.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <Label style="-fx-font-size: 20px;                               -fx-font-weight: bold;                               -fx-text-fill: white;                               -fx-font-family: 'Segoe UI Semibold', SansSerif;" text="CÔNG TY 4N" />

                <Label style="-fx-font-size: 18px; -fx-text-fill: #81d4fa;" text="›" />

                <Label style="-fx-font-size: 14px;                               -fx-text-fill: #b3d9f7;                               -fx-font-family: 'Segoe UI', SansSerif;" text="Seller Dashboard" />

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Post button -->
                <Button mnemonicParsing="false" onAction="#handlePostItem" prefHeight="38.0" style="-fx-background-color: white;                                -fx-text-fill: #0277bd;                                -fx-font-weight: bold;                                -fx-font-size: 13px;                                -fx-font-family: 'Segoe UI Semibold', SansSerif;                                -fx-background-radius: 10;                                -fx-cursor: hand;                                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 6, 0, 0, 2);" text="📤  Đăng bán sản phẩm" />
            </HBox>
        </VBox>
    </top>

    <!-- ══ CENTER — TABLE ════════════════════════════════════════ -->
    <center>
        <VBox style="-fx-background-color: #e8f0fe;">
            <padding>
                <Insets bottom="20.0" left="28.0" right="28.0" top="20.0" />
            </padding>

            <!-- Section title -->
            <Label style="-fx-font-size: 15px;                           -fx-font-weight: bold;                           -fx-text-fill: #01294e;                           -fx-font-family: 'Segoe UI Semibold', SansSerif;" text="Sản phẩm của tôi" />

            <Region prefHeight="10.0" />

            <!-- Table card -->
            <TableView fx:id="tableMyItems" style="-fx-background-color: white;                               -fx-background-radius: 12;                               -fx-border-color: #b0cceb;                               -fx-border-radius: 12;                               -fx-border-width: 1.5;                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colItemName" prefWidth="320.0" style="-fx-font-family: 'Segoe UI Semibold', SansSerif;                                         -fx-font-size: 13px;" text="Tên sản phẩm" />

                    <TableColumn fx:id="colPrice" prefWidth="220.0" style="-fx-font-family: 'Segoe UI Semibold', SansSerif;                                         -fx-font-size: 13px;" text="Giá khởi điểm (VNĐ)" />

                    <TableColumn fx:id="colStatus" prefWidth="200.0" style="-fx-font-family: 'Segoe UI Semibold', SansSerif;                                         -fx-font-size: 13px;" text="Trạng thái" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- ══ BOTTOM NAV BAR ════════════════════════════════════════ -->
    <bottom>
        <HBox alignment="CENTER" prefHeight="64.0" spacing="16.0" style="-fx-background-color: white;                      -fx-border-color: #b0cceb;                      -fx-border-width: 1.5 0 0 0;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, -2);">
            <padding>
                <Insets left="28.0" right="28.0" />
            </padding>

            <Button mnemonicParsing="false" onAction="#handleSetting" prefHeight="38.0" prefWidth="130.0" style="-fx-background-color: #f0f6ff;                            -fx-border-color: #b0cceb;                            -fx-border-width: 1.5;                            -fx-border-radius: 10;                            -fx-background-radius: 10;                            -fx-text-fill: #0277bd;                            -fx-font-size: 13px;                            -fx-font-family: 'Segoe UI', SansSerif;                            -fx-cursor: hand;" text="⚙  Cài đặt" />

            <Button mnemonicParsing="false" onAction="#handleWallet" prefHeight="38.0" prefWidth="130.0" style="-fx-background-color: #f0f6ff;                            -fx-border-color: #b0cceb;                            -fx-border-width: 1.5;                            -fx-border-radius: 10;                            -fx-background-radius: 10;                            -fx-text-fill: #0277bd;                            -fx-font-size: 13px;                            -fx-font-family: 'Segoe UI', SansSerif;                            -fx-cursor: hand;" text="💰  Ví tiền" />

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS" />

            <Button mnemonicParsing="false" onAction="#handleLogout" prefHeight="38.0" prefWidth="130.0" style="-fx-background-color: linear-gradient(to right, #0277bd, #01579b);                            -fx-text-fill: white;                            -fx-font-size: 13px;                            -fx-font-weight: bold;                            -fx-font-family: 'Segoe UI Semibold', SansSerif;                            -fx-background-radius: 10;                            -fx-cursor: hand;                            -fx-effect: dropshadow(gaussian, rgba(1,87,155,0.35), 8, 0, 0, 3);" text="🚪  Đăng xuất" />
        </HBox>
    </bottom>

</BorderPane>
