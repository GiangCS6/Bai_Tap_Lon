<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.bai_tap_lon.controller.SellerController">

    <top>
        <VBox spacing="15" alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="👨‍💼 SELLER DASHBOARD"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Button fx:id="btnPostItem"
                    text="📤 ĐĂNG BÁN SẢN PHẨM"
                    onAction="#handlePostItem"
                    prefWidth="350"
                    style="-fx-base: #FF9800;
                           -fx-text-fill: white;
                           -fx-font-size: 16px;"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tableMyItems">
            <columns>
                <TableColumn fx:id="colItemName"
                             text="Tên sản phẩm"
                             prefWidth="250"/>

                <TableColumn fx:id="colPrice"
                             text="Giá"
                             prefWidth="150"/>

                <TableColumn fx:id="colStatus"
                             text="Trạng thái"
                             prefWidth="150"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER"
              spacing="40"
              prefHeight="60"
              style="-fx-background-color: #f5f5f5;
                     -fx-border-color: #ddd;
                     -fx-border-width: 1 0 0 0;">

            <Button text="⚙ Setting"
                    onAction="#handleSetting"/>

            <Button text="💰 Wallet"
                    onAction="#handleWallet"/>

            <Button text="🚪 Logout"
                    onAction="#handleLogout"/>
        </HBox>
    </bottom>

</BorderPane>