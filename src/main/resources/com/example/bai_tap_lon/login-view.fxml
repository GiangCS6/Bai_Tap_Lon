<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.bai_tap_lon.controller.LoginController"
            prefHeight="450" prefWidth="380">

    <VBox alignment="CENTER" spacing="20" AnchorPane.topAnchor="40"
          AnchorPane.bottomAnchor="40" AnchorPane.leftAnchor="40" AnchorPane.rightAnchor="40">

        <Label text="🔑 ĐĂNG NHẬP" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        <VBox spacing="10" alignment="CENTER">
            <Label text="Tài khoản" style="-fx-font-size: 14px;"/>
            <TextField fx:id="txtUsername" promptText="Nhập username" prefWidth="280"/>
        </VBox>

        <VBox spacing="10" alignment="CENTER">
            <Label text="Mật khẩu" style="-fx-font-size: 14px;"/>
            <PasswordField fx:id="txtPassword" promptText="Nhập mật khẩu" prefWidth="280"/>
        </VBox>

        <ComboBox fx:id="cbRole" promptText="Chọn vai trò" prefWidth="280">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Bidder"/>
                    <String fx:value="Seller"/>
                    <String fx:value="Admin"/>
                </FXCollections>
            </items>
        </ComboBox>

        <Button fx:id="btnLogin" text="ĐĂNG NHẬP" onAction="#handleLogin"
                prefWidth="280" style="-fx-base: #2196F3; -fx-text-fill: white; -fx-font-size: 15px;"/>

        <HBox alignment="CENTER" spacing="10">
            <Label text="Chưa có tài khoản?" style="-fx-font-size: 13px;"/>
            <Hyperlink text="Đăng ký ngay" onAction="#goToSignup"/>
        </HBox>

    </VBox>
</AnchorPane>