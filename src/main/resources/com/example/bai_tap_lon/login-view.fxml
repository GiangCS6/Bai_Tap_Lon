<?xml version="1.0" encoding="UTF-8"?>


<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.bai_tap_lon.controller.LoginController"
            prefHeight="400.0" prefWidth="600.0">

</AnchorPane>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="420.0" prefWidth="600.0" spacing="14.0"
      style="-fx-background-color: #f6f8fb;"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.bai_tap_lon.controller.LoginController">
    <padding>
        <Insets bottom="32.0" left="48.0" right="48.0" top="32.0" />
    </padding>

    <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1f3349;" text="Đăng nhập" />
    <Label style="-fx-text-fill: #607080;" text="Sử dụng tài khoản đấu giá của bạn." />

    <VBox maxWidth="360.0" spacing="10.0">
        <TextField fx:id="usernameField" prefHeight="38.0" promptText="Tên đăng nhập" />
        <PasswordField fx:id="passwordField" prefHeight="38.0" promptText="Mật khẩu" />
        <Label fx:id="messageLabel" minHeight="22.0" style="-fx-text-fill: #b42318;" />
        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin" prefHeight="38.0"
                style="-fx-background-color: #265f9f; -fx-text-fill: white; -fx-font-weight: bold;"
                text="Đăng nhập" />
        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSignup" prefHeight="36.0"
                style="-fx-background-color: transparent; -fx-border-color: #265f9f; -fx-text-fill: #265f9f;"
                text="Tạo tài khoản" />
        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showWelcome" prefHeight="32.0"
                style="-fx-background-color: transparent; -fx-text-fill: #607080;"
                text="Quay lại" />
    </VBox>
</VBox>

