<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.bai_tap_lon.controller.MainController"
      spacing="15" alignment="CENTER">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Tiêu đề -->
    <Label text="🔥 DANH SÁCH MÓN ĐẤU GIÁ"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #d32f2f;"/>

    <!-- Bảng đấu giá -->
    <TableView fx:id="tableItems" prefHeight="400" editable="false">
        <columns>
            <TableColumn fx:id="colItemName" text="Món đấu giá" prefWidth="320"/>
            <TableColumn fx:id="colCurrentPrice" text="Giá hiện tại (VNĐ)" prefWidth="220"/>
            <TableColumn fx:id="colHighestBidder" text="Người đấu cao nhất" prefWidth="250"/>
        </columns>
    </TableView>

    <!-- Phần đặt giá -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Số tiền đấu giá:" style="-fx-font-size: 14px;"/>
        <TextField fx:id="txtBidAmount" promptText="Nhập số tiền" prefWidth="220"/>
        <Button fx:id="btnBid" text="ĐẶT GIÁ" onAction="#handleBid"
                prefWidth="130" style="-fx-base: #4CAF50; -fx-text-fill: white;"/>
    </HBox>

    <!-- Log -->
    <!--<Label text="📜 Log hệ thống" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    <TextArea fx:id="txtLog" editable="false" prefHeight="160" wrapText="true"
              style="-fx-font-family: monospace; -fx-font-size: 13px;"/>-->
    <HBox alignment="CENTER"
          spacing="40"
          prefHeight="60"
          style="-fx-background-color: #f5f5f5;
             -fx-border-color: #ddd;
             -fx-border-width: 1 0 0 0;">

        <Button text="⚙ Setting"
                onAction="#handleSetting"/>

        <Button text="💰 Wallet"
                onAction="#handleWallet"/>

        <Button text="🚪 Logout"
                onAction="#handleLogout"/>
    </HBox>

</VBox>