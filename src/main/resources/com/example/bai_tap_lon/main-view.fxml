<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1120.0" style="-fx-background-color: #f4f6f8;"
           xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.bai_tap_lon.controller.MainController">

    <VBox fx:id="authPane" alignment="CENTER" spacing="18.0" style="-fx-background-color: #eef2f6;">
        <VBox maxWidth="420.0" spacing="14.0" style="-fx-background-color: white; -fx-padding: 28; -fx-background-radius: 8;">
            <Label style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1f3349;" text="DAU GIA UY TIN" />
            <Label style="-fx-text-fill: #607080;" text="Chon cach bat dau voi he thong dau gia" />

            <VBox fx:id="authChoicePane" spacing="10.0">
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showLoginForm"
                        style="-fx-background-color: #265f9f; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="LOG IN" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showSignupForm"
                        style="-fx-background-color: transparent; -fx-border-color: #265f9f; -fx-text-fill: #265f9f; -fx-font-weight: bold;"
                        text="SIGN IN" />
            </VBox>

            <VBox fx:id="loginPane" managed="false" spacing="10.0" visible="false">
                <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Dang nhap" />
                <TextField fx:id="loginUsernameField" promptText="Ten dang nhap" />
                <PasswordField fx:id="loginPasswordField" promptText="Mat khau" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin"
                        style="-fx-background-color: #265f9f; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="LOG IN" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showAuthChoice"
                        style="-fx-background-color: transparent; -fx-text-fill: #607080;"
                        text="Quay lai" />
            </VBox>

            <VBox fx:id="signupPane" managed="false" spacing="10.0" visible="false">
                <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Dang ky tai khoan" />
                <TextField fx:id="signupFullNameField" promptText="Ho va ten" />
                <TextField fx:id="signupUsernameField" promptText="Ten dang nhap" />
                <PasswordField fx:id="signupPasswordField" promptText="Mat khau" />
                <ComboBox fx:id="signupRoleBox" maxWidth="Infinity" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSignup"
                        style="-fx-background-color: #265f9f; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="SIGN IN" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showAuthChoice"
                        style="-fx-background-color: transparent; -fx-text-fill: #607080;"
                        text="Quay lai" />
            </VBox>

            <Separator />
            <Label fx:id="authMessageLabel" wrapText="true" style="-fx-text-fill: #b42318;" />
        </VBox>
    </VBox>

    <BorderPane fx:id="appPane" managed="false" visible="false">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: #1f3349;">
                <padding>
                    <Insets bottom="14.0" left="18.0" right="18.0" top="14.0" />
                </padding>
                <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;" text="DAU GIA UY TIN" />
                <Label fx:id="currentUserLabel" style="-fx-text-fill: #d7e3ef;" text="Chua dang nhap" />
                <HBox HBox.hgrow="ALWAYS" />
                <Button fx:id="logoutButton" disable="true" mnemonicParsing="false" onAction="#handleLogout" text="Dang xuat" />
            </HBox>
        </top>

        <center>
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                </padding>
                <TabPane fx:id="mainTabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="San pham dau gia">
                            <VBox spacing="12.0">
                                <padding>
                                    <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                                </padding>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="San pham dau gia" />
                                    <HBox HBox.hgrow="ALWAYS" />
                                    <Button mnemonicParsing="false" onAction="#handleRefresh" text="Cap nhat trang thai" />
                                </HBox>
                                <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                                    <TableView fx:id="auctionTable" HBox.hgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="nameColumn" prefWidth="320.0" text="San pham" />
                                            <TableColumn fx:id="priceColumn" prefWidth="180.0" text="Gia hien tai" />
                                            <TableColumn fx:id="statusColumn" prefWidth="130.0" text="Trang thai" />
                                            <TableColumn fx:id="endTimeColumn" prefWidth="190.0" text="Ket thuc" />
                                        </columns>
                                    </TableView>

                                    <VBox fx:id="sellerPane" prefWidth="320.0" spacing="10.0" style="-fx-background-color: white; -fx-padding: 14;">
                                        <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Them san pham dau gia" />
                                        <TextField fx:id="itemNameField" promptText="Ten san pham" />
                                        <TextArea fx:id="itemDescriptionArea" prefRowCount="4" promptText="Mo ta" wrapText="true" />
                                        <TextField fx:id="itemStartingPriceField" promptText="Gia khoi diem" />
                                        <Label text="Dinh dang thoi gian: yyyy-MM-dd HH:mm" style="-fx-text-fill: #607080;" />
                                        <TextField fx:id="itemStartTimeField" promptText="Thoi gian bat dau" />
                                        <TextField fx:id="itemEndTimeField" promptText="Thoi gian ket thuc" />
                                        <Button fx:id="addItemButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleAddItem" text="Them san pham" />
                                        <Separator />
                                        <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Sua / xoa san pham da chon" />
                                        <Button fx:id="updateItemButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleUpdateItem" text="Sua san pham" />
                                        <Button fx:id="deleteItemButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleDeleteItem" text="Xoa san pham" />
                                    </VBox>
                                </HBox>
                            </VBox>
                        </Tab>

                        <Tab text="Chi tiet san pham">
                            <VBox spacing="12.0" style="-fx-background-color: white;">
                                <padding>
                                    <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                                </padding>
                                <Label fx:id="detailNameLabel" style="-fx-font-size: 22; -fx-font-weight: bold;" text="Chua chon phien" />
                                <Label fx:id="detailDescriptionLabel" wrapText="true" />
                                <GridPane hgap="12.0" vgap="9.0">
                                    <Label text="Seller:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <Label fx:id="detailSellerLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                    <Label text="Bat dau:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <Label fx:id="detailStartLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label text="Ket thuc:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                    <Label fx:id="detailEndLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Label text="Trang thai:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                    <Label fx:id="detailStatusLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    <Label text="Gia cao nhat:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                    <Label fx:id="detailCurrentPriceLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                    <Label text="Nguoi dan dau:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                    <Label fx:id="detailLeaderLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                </GridPane>
                                <Label style="-fx-font-weight: bold;" text="Lich su dau gia" />
                                <ListView fx:id="bidHistoryList" VBox.vgrow="ALWAYS" />
                            </VBox>
                        </Tab>

                        <Tab fx:id="liveAuctionTab" text="Dau gia truc tiep">
                            <VBox spacing="14.0" style="-fx-background-color: white;">
                                <padding>
                                    <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                                </padding>
                                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Dat gia cho phien dang RUNNING" />
                                <Label wrapText="true" text="Chon san pham muon dau gia, sau do nhap gia cao hon gia hien tai." />
                                <ComboBox fx:id="bidItemComboBox" maxWidth="420.0" promptText="Chon san pham dau gia" />
                                <HBox maxWidth="420.0" spacing="8.0">
                                    <TextField fx:id="bidAmountField" promptText="Gia muon dat" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="bidButton" mnemonicParsing="false" onAction="#handlePlaceBid"
                                            style="-fx-background-color: #265f9f; -fx-text-fill: white;"
                                            text="Dat gia" />
                                </HBox>
                            </VBox>
                        </Tab>

                        <Tab fx:id="adminTab" text="Quan tri Admin">
                            <VBox fx:id="adminPane" spacing="12.0" style="-fx-background-color: white;">
                                <padding>
                                    <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                                </padding>
                                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Xu ly ket thuc phien dau gia" />
                                <Label wrapText="true" text="Chon phien FINISHED o tab Danh sach de chuyen sang PAID, hoac huy phien khi can." />
                                <HBox spacing="8.0">
                                    <Button fx:id="markPaidButton" mnemonicParsing="false" onAction="#handleMarkPaid" text="Chuyen sang PAID" />
                                    <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" text="Huy phien" />
                                </HBox>
                            </VBox>
                        </Tab>
                    </tabs>
                </TabPane>
                <Label fx:id="systemMessageLabel" minHeight="24.0" style="-fx-text-fill: #1f3349;" />
            </VBox>
        </center>
    </BorderPane>
</StackPane>
