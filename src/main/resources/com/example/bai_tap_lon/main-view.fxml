<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1120.0" style="-fx-background-color: #e8f0fe;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.bai_tap_lon.controller.MainController">

    <!-- ══════════════════════════════════════════════════════════
         AUTH PANE  (hiển thị khi chưa đăng nhập)
    ══════════════════════════════════════════════════════════════ -->
    <VBox fx:id="authPane" alignment="CENTER" spacing="0.0" style="-fx-background-color: #e8f0fe;">

        <!-- Card trung tâm -->
        <HBox alignment="CENTER" maxHeight="520.0" maxWidth="860.0" style="-fx-background-color: white;                      -fx-background-radius: 20;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 32, 0.1, 0, 8);">

            <!-- ── Left brand panel ── -->
            <VBox alignment="CENTER" minHeight="480.0" prefWidth="300.0" spacing="18.0" style="-fx-background-color: linear-gradient(to bottom, #0277bd, #01579b, #023872);                          -fx-background-radius: 20 0 0 20;">
                <padding>
                    <Insets bottom="48.0" left="32.0" right="32.0" top="48.0" />
                </padding>
                <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;                               -fx-font-family: 'Segoe UI Semibold', SansSerif;" text="CÔNG TY 4N" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #81d4fa;                               -fx-font-family: 'Segoe UI', SansSerif;                               -fx-text-alignment: center; -fx-wrap-text: true;" text="Nền tảng đấu giá trực tuyến&#10;uy tín &amp; minh bạch" />
                <Region VBox.vgrow="ALWAYS" />
                <VBox spacing="10.0">
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #81d4fa;" text="✔  Đặt giá thầu dễ dàng" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #81d4fa;" text="✔  Theo dõi real-time" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #81d4fa;" text="✔  Giao dịch an toàn" />
                </VBox>
                <Region VBox.vgrow="ALWAYS" />
                <Label style="-fx-font-size: 10px; -fx-text-fill: #4a6f96;" text="© 2025 AuctionHub. All rights reserved." />
            </VBox>

            <!-- ── Right form panel ── -->
            <VBox alignment="CENTER" spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 0 20 20 0;" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets bottom="44.0" left="52.0" right="52.0" top="44.0" />
                </padding>

                <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #01294e;                               -fx-font-family: 'Segoe UI Semibold', SansSerif;" text="Chào mừng quý khách" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #5482a0;                               -fx-font-family: 'Segoe UI', SansSerif; -fx-padding: 4 0 0 0;" text="Chọn cách bắt đầu với hệ thống đấu giá." />

                <Region prefHeight="24.0" />

                <!-- == Auth choice == -->
                <VBox fx:id="authChoicePane" spacing="12.0">
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showLoginForm" prefHeight="44.0" style="-fx-background-color: linear-gradient(to right, #0277bd, #01579b);                                    -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;                                    -fx-font-family: 'Segoe UI Semibold', SansSerif;                                    -fx-background-radius: 11; -fx-cursor: hand;                                    -fx-effect: dropshadow(gaussian, rgba(1,87,155,0.38),12,0,0,5);" text="ĐĂNG NHẬP" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showSignupForm" prefHeight="42.0" style="-fx-background-color: transparent;                                    -fx-border-color: #0277bd; -fx-border-width: 1.8;                                    -fx-border-radius: 11; -fx-background-radius: 11;                                    -fx-text-fill: #0277bd; -fx-font-size: 13px; -fx-font-weight: bold;                                    -fx-font-family: 'Segoe UI Semibold', SansSerif; -fx-cursor: hand;" text="TẠO TÀI KHOẢN" />
                </VBox>

                <!-- == Login form == -->
                <VBox fx:id="loginPane" managed="false" spacing="12.0" visible="false">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #01294e;                                   -fx-font-family: 'Segoe UI Semibold', SansSerif;" text="Đăng nhập" />
                    <VBox spacing="4.0">
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1e3f60;                                       -fx-font-family: 'Segoe UI Semibold', SansSerif;" text="TÊN ĐĂNG NHẬP" />
                        <TextField fx:id="loginUsernameField" prefHeight="40.0" promptText="username" style="-fx-background-color: #f0f6ff; -fx-border-color: #b0cceb;                                           -fx-border-radius: 9; -fx-background-radius: 9;                                           -fx-border-width: 1.5; -fx-font-size: 13px;" />
                    </VBox>
                    <VBox spacing="4.0">
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1e3f60;                                       -fx-font-family: 'Segoe UI Semibold', SansSerif;" text="MẬT KHẨU" />
                        <PasswordField fx:id="loginPasswordField" prefHeight="40.0" promptText="••••••••" style="-fx-background-color: #f0f6ff; -fx-border-color: #b0cceb;                                               -fx-border-radius: 9; -fx-background-radius: 9;                                               -fx-border-width: 1.5; -fx-font-size: 13px;" />
                    </VBox>
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin" prefHeight="42.0" style="-fx-background-color: linear-gradient(to right, #0277bd, #01579b);                                    -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;                                    -fx-background-radius: 10; -fx-cursor: hand;" text="ĐĂNG NHẬP" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showAuthChoice" prefHeight="36.0" style="-fx-background-color: transparent; -fx-text-fill: #5482a0;                                    -fx-font-size: 12px; -fx-cursor: hand;" text="← Quay lại" />
                </VBox>

                <!-- == Signup form == -->
                <VBox fx:id="signupPane" managed="false" spacing="10.0" visible="false">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #01294e;                                   -fx-font-family: 'Segoe UI Semibold', SansSerif;" text="Tạo tài khoản" />
                    <TextField fx:id="signupFullNameField" prefHeight="38.0" promptText="Họ và tên" style="-fx-background-color: #f0f6ff; -fx-border-color: #b0cceb;                                       -fx-border-radius: 9; -fx-background-radius: 9;                                       -fx-border-width: 1.5; -fx-font-size: 13px;" />
                    <TextField fx:id="signupUsernameField" prefHeight="38.0" promptText="Tên đăng nhập" style="-fx-background-color: #f0f6ff; -fx-border-color: #b0cceb;                                       -fx-border-radius: 9; -fx-background-radius: 9;                                       -fx-border-width: 1.5; -fx-font-size: 13px;" />
                    <PasswordField fx:id="signupPasswordField" prefHeight="38.0" promptText="Mật khẩu" style="-fx-background-color: #f0f6ff; -fx-border-color: #b0cceb;                                           -fx-border-radius: 9; -fx-background-radius: 9;                                           -fx-border-width: 1.5; -fx-font-size: 13px;" />
                    <ComboBox fx:id="signupRoleBox" maxWidth="Infinity" prefHeight="38.0" style="-fx-background-color: #f0f6ff; -fx-border-color: #b0cceb;                                      -fx-border-radius: 9; -fx-background-radius: 9;                                      -fx-border-width: 1.5; -fx-font-size: 13px;" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSignup" prefHeight="42.0" style="-fx-background-color: linear-gradient(to right, #0277bd, #01579b);                                    -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;                                    -fx-background-radius: 10; -fx-cursor: hand;" text="ĐĂNG KÝ" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showAuthChoice" prefHeight="36.0" style="-fx-background-color: transparent; -fx-text-fill: #5482a0;                                    -fx-font-size: 12px; -fx-cursor: hand;" text="← Quay lại" />
                </VBox>

                <Region prefHeight="14.0" />

                <!-- Divider -->
                <HBox alignment="CENTER" spacing="10.0">
                    <Region style="-fx-background-color: #ccdff2; -fx-pref-height: 1.5; -fx-max-height: 1.5;" HBox.hgrow="ALWAYS" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #88a8c4;" text="Tạo tài khoản ngay " />
                    <Region style="-fx-background-color: #ccdff2; -fx-pref-height: 1.5; -fx-max-height: 1.5;" HBox.hgrow="ALWAYS" />
                </HBox>

                <Region prefHeight="8.0" />

                <Label fx:id="authMessageLabel" maxWidth="Infinity" style="-fx-text-fill: #c0392b; -fx-font-size: 12px;                               -fx-font-family: 'Segoe UI', SansSerif; -fx-min-height: 18;" wrapText="true" />
            </VBox>
        </HBox>
    </VBox>

    <!-- ══════════════════════════════════════════════════════════
         APP PANE  (hiển thị sau khi đăng nhập)
    ══════════════════════════════════════════════════════════════ -->
    <BorderPane fx:id="appPane" managed="false" visible="false">

        <!-- ── Top header bar ── -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-background-color: linear-gradient(to right, #0277bd, #01579b);                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.22), 12, 0, 0, 4);">
                <padding>
                    <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
                </padding>

                <Label style="-fx-font-size: 22px; -fx-text-fill: #81d4fa;" text="🔨" />
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;                               -fx-font-family: 'Segoe UI Semibold', SansSerif;" text="AuctionHub" />

                <Label style="-fx-text-fill: #4a90c4; -fx-font-size: 18px;" text="│" />

                <Label fx:id="currentUserLabel" style="-fx-text-fill: #b3d9f7; -fx-font-size: 13px;                               -fx-font-family: 'Segoe UI', SansSerif;" text="Chưa đăng nhập" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="logoutButton" disable="true" mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: rgba(255,255,255,0.15);                                -fx-text-fill: white; -fx-font-size: 12px;                                -fx-border-color: rgba(255,255,255,0.4); -fx-border-width: 1;                                -fx-border-radius: 8; -fx-background-radius: 8;                                -fx-cursor: hand; -fx-padding: 6 14;" text="🚪  Đăng xuất" />
            </HBox>
        </top>

        <!-- ── Center content ── -->
        <center>
            <VBox spacing="0.0" style="-fx-background-color: #e8f0fe;">
                <padding>
                    <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
                </padding>

                <TabPane fx:id="mainTabs" style="-fx-background-color: white;                                 -fx-background-radius: 12;                                 -fx-border-color: #b0cceb;                                 -fx-border-radius: 12;                                 -fx-border-width: 1.5;                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>

                        <!-- ══ Tab 1: Sản phẩm đấu giá ══ -->
                        <Tab text="Sản phẩm đấu giá">
                            <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 0 12 12 12;">
                                <padding>
                                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                </padding>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;                                                   -fx-text-fill: #01294e;                                                   -fx-font-family: 'Segoe UI Semibold', SansSerif;" text="Sản phẩm đấu giá" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button mnemonicParsing="false" onAction="#handleRefresh" prefHeight="34.0" style="-fx-background-color: #f0f6ff;                                                    -fx-border-color: #b0cceb; -fx-border-width: 1.5;                                                    -fx-border-radius: 8; -fx-background-radius: 8;                                                    -fx-text-fill: #0277bd; -fx-font-size: 12px;                                                    -fx-cursor: hand;" text="🔄  Cập nhật trạng thái" />
                                </HBox>

                                <HBox spacing="14.0" VBox.vgrow="ALWAYS">

                                    <!-- Table -->
                                    <TableView fx:id="auctionTable" style="-fx-background-radius: 8; -fx-border-color: #ccdff2;                                                       -fx-border-radius: 8; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="nameColumn" prefWidth="300.0" text="Sản phẩm" />
                                            <TableColumn fx:id="priceColumn" prefWidth="170.0" text="Giá hiện tại" />
                                            <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Trạng thái" />
                                            <TableColumn fx:id="ownerColumn" prefWidth="170.0" text="Chủ sở hữu" />
                                            <TableColumn fx:id="endTimeColumn" prefWidth="180.0" text="Kết thúc" />
                                        </columns>
                                    </TableView>

                                    <!-- Seller form (chỉ visible với SELLER) -->
                                    <VBox fx:id="sellerPane" prefWidth="300.0" spacing="8.0" style="-fx-background-color: #f8fbff;                                                  -fx-border-color: #b0cceb; -fx-border-width: 1.5;                                                  -fx-border-radius: 10; -fx-background-radius: 10;                                                  -fx-padding: 14;">
                                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;                                                       -fx-text-fill: #01294e;                                                       -fx-font-family: 'Segoe UI Semibold', SansSerif;" text="Thêm sản phẩm đấu giá" />
                                        <TextField fx:id="itemNameField" prefHeight="36.0" promptText="Tên sản phẩm" style="-fx-background-color: #f0f6ff; -fx-border-color: #b0cceb;                                                           -fx-border-radius: 8; -fx-background-radius: 8;                                                           -fx-border-width: 1.5;" />
                                        <TextArea fx:id="itemDescriptionArea" prefRowCount="3" promptText="Mô tả" style="-fx-background-color: #f0f6ff; -fx-border-color: #b0cceb;                                                          -fx-border-radius: 8; -fx-background-radius: 8;                                                          -fx-border-width: 1.5;" wrapText="true" />
                                        <TextField fx:id="itemStartingPriceField" prefHeight="36.0" promptText="Giá khởi điểm" style="-fx-background-color: #f0f6ff; -fx-border-color: #b0cceb;                                                           -fx-border-radius: 8; -fx-background-radius: 8;                                                           -fx-border-width: 1.5;" />
                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #88a8c4;" text="Định dạng: yyyy-MM-dd HH:mm" />
                                        <TextField fx:id="itemStartTimeField" prefHeight="36.0" promptText="Thời gian bắt đầu" style="-fx-background-color: #f0f6ff; -fx-border-color: #b0cceb;                                                           -fx-border-radius: 8; -fx-background-radius: 8;                                                           -fx-border-width: 1.5;" />
                                        <TextField fx:id="itemEndTimeField" prefHeight="36.0" promptText="Thời gian kết thúc" style="-fx-background-color: #f0f6ff; -fx-border-color: #b0cceb;                                                           -fx-border-radius: 8; -fx-background-radius: 8;                                                           -fx-border-width: 1.5;" />
                                        <Button fx:id="addItemButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleAddItem" prefHeight="38.0" style="-fx-background-color: linear-gradient(to right, #0277bd, #01579b);                                                        -fx-text-fill: white; -fx-font-weight: bold;                                                        -fx-background-radius: 9; -fx-cursor: hand;" text="Thêm sản phẩm" />
                                        <Separator />
                                        <Label style="-fx-font-size: 13px; -fx-font-weight: bold;                                                       -fx-text-fill: #01294e;" text="Sửa hoặc xóa sản phẩm đã chọn" />
                                        <Button fx:id="updateItemButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleUpdateItem" prefHeight="36.0" style="-fx-background-color: #f0f6ff;                                                        -fx-border-color: #0277bd; -fx-border-width: 1.5;                                                        -fx-border-radius: 9; -fx-background-radius: 9;                                                        -fx-text-fill: #0277bd; -fx-cursor: hand;" text="Sửa sản phẩm" />
                                        <Button fx:id="deleteItemButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleDeleteItem" prefHeight="36.0" style="-fx-background-color: #fff0f0;                                                        -fx-border-color: #e05a5a; -fx-border-width: 1.5;                                                        -fx-border-radius: 9; -fx-background-radius: 9;                                                        -fx-text-fill: #c0392b; -fx-cursor: hand;" text="Xóa sản phẩm" />
                                    </VBox>
                                </HBox>
                            </VBox>
                        </Tab>

                        <!-- ══ Tab 2: Chi tiết sản phẩm ══ -->
                        <Tab text="Chi tiết sản phẩm">
                            <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 0 12 12 12;">
                                <padding>
                                    <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                                </padding>

                                <Label fx:id="detailNameLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;                                               -fx-text-fill: #01294e;                                               -fx-font-family: 'Segoe UI Semibold', SansSerif;" text="Chưa chọn phiên" />
                                <Label fx:id="detailDescriptionLabel" style="-fx-text-fill: #5482a0; -fx-font-size: 13px;" wrapText="true" />

                                <!-- Info grid card -->
                                <VBox style="-fx-background-color: #f8fbff;                                              -fx-border-color: #b0cceb; -fx-border-width: 1.5;                                              -fx-border-radius: 10; -fx-background-radius: 10;                                              -fx-padding: 14;">
                                    <GridPane hgap="20.0" vgap="10.0">
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #1e3f60;" text="Người bán:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <Label fx:id="detailSellerLabel" style="-fx-text-fill: #334e6e;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #1e3f60;" text="Bắt đầu:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <Label fx:id="detailStartLabel" style="-fx-text-fill: #334e6e;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #1e3f60;" text="Kết thúc:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                        <Label fx:id="detailEndLabel" style="-fx-text-fill: #334e6e;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #1e3f60;" text="Trạng thái:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                        <Label fx:id="detailStatusLabel" style="-fx-text-fill: #334e6e;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #1e3f60;" text="Giá cao nhất:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                        <Label fx:id="detailCurrentPriceLabel" style="-fx-text-fill: #0277bd; -fx-font-weight: bold;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #1e3f60;" text="Người dẫn đầu:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                        <Label fx:id="detailLeaderLabel" style="-fx-text-fill: #334e6e;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #1e3f60;" text="Giá khởi điểm:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                                        <Label fx:id="detailStartingPriceLabel" style="-fx-text-fill: #334e6e;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                              <columnConstraints>
                                 <ColumnConstraints />
                                 <ColumnConstraints />
                              </columnConstraints>
                              <rowConstraints>
                                 <RowConstraints />
                                 <RowConstraints />
                                 <RowConstraints />
                                 <RowConstraints />
                                 <RowConstraints />
                                 <RowConstraints />
                                 <RowConstraints />
                              </rowConstraints>
                                    </GridPane>
                                </VBox>

                                <Label style="-fx-font-weight: bold; -fx-text-fill: #01294e;                                               -fx-font-size: 13px;" text="Lịch sử đặt giá" />
                                <ListView fx:id="bidHistoryList" style="-fx-background-radius: 8; -fx-border-color: #ccdff2;                                                  -fx-border-radius: 8;" VBox.vgrow="ALWAYS" />
                            </VBox>
                        </Tab>

                        <!-- ══ Tab 3: Đấu giá trực tiếp ══ -->
                        <Tab fx:id="liveAuctionTab" text="Đấu giá trực tiếp">
                            <VBox spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 0 12 12 12;">
                                <padding>
                                    <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                                </padding>

                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;                                               -fx-text-fill: #01294e;                                               -fx-font-family: 'Segoe UI Semibold', SansSerif;" text="Đặt giá cho phiên đang diễn ra" />
                                <Label style="-fx-text-fill: #5482a0; -fx-font-size: 13px;" text="Chọn sản phẩm muốn đấu giá, sau đó nhập giá cao hơn giá hiện tại." wrapText="true" />

                                <ComboBox fx:id="bidItemComboBox" maxWidth="440.0" prefHeight="40.0" promptText="Chọn sản phẩm đấu giá" style="-fx-background-color: #f0f6ff; -fx-border-color: #b0cceb;                                                  -fx-border-radius: 9; -fx-background-radius: 9;                                                  -fx-border-width: 1.5; -fx-font-size: 13px;" />

                                <HBox maxWidth="440.0" spacing="8.0">
                                    <TextField fx:id="bidAmountField" prefHeight="40.0" promptText="Nhập giá muốn đặt (VNĐ)" style="-fx-background-color: #f0f6ff; -fx-border-color: #b0cceb;                                                       -fx-border-radius: 9; -fx-background-radius: 9;                                                       -fx-border-width: 1.5; -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="bidButton" mnemonicParsing="false" onAction="#handlePlaceBid" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: linear-gradient(to right, #0277bd, #01579b);                                                    -fx-text-fill: white; -fx-font-weight: bold;                                                    -fx-background-radius: 9; -fx-cursor: hand;" text="Đặt giá" />
                                </HBox>
                            </VBox>
                        </Tab>

                        <!-- ══ Tab 4: Quản trị viên ══ -->
                        <Tab fx:id="adminTab" text="Quản trị viên">
                            <VBox fx:id="adminPane" spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 0 12 12 12;">
                                <padding>
                                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                </padding>

                                <TabPane style="-fx-background-color: transparent;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                                    <tabs>

                                        <!-- Admin sub-tab: Người dùng -->
                                        <Tab text="Quản lý người dùng">
                                            <VBox spacing="12.0">
                                                <padding>
                                                    <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                                                </padding>

                                                <Label style="-fx-font-size: 15px; -fx-font-weight: bold;                                                               -fx-text-fill: #01294e;                                                               -fx-font-family: 'Segoe UI Semibold', SansSerif;" text="Quản lý người dùng" />

                                                <HBox spacing="8.0">
                                                    <Button mnemonicParsing="false" onAction="#handleRefreshUsers" prefHeight="34.0" style="-fx-background-color: #f0f6ff;                                                                    -fx-border-color: #b0cceb; -fx-border-width: 1.5;                                                                    -fx-border-radius: 8; -fx-background-radius: 8;                                                                    -fx-text-fill: #0277bd; -fx-font-size: 12px; -fx-cursor: hand;" text="🔄  Xem danh sách" />
                                                    <Button fx:id="deleteUserButton" disable="true" mnemonicParsing="false" onAction="#handleDeleteUser" prefHeight="34.0" style="-fx-background-color: #fff0f0;                                                                    -fx-border-color: #e05a5a; -fx-border-width: 1.5;                                                                    -fx-border-radius: 8; -fx-background-radius: 8;                                                                    -fx-text-fill: #c0392b; -fx-font-size: 12px; -fx-cursor: hand;" text="Xóa tài khoản" />
                                                    <Button fx:id="toggleUserLockButton" disable="true" mnemonicParsing="false" onAction="#handleToggleUserLock" prefHeight="34.0" style="-fx-background-color: #fffbf0;                                                                    -fx-border-color: #d4a017; -fx-border-width: 1.5;                                                                    -fx-border-radius: 8; -fx-background-radius: 8;                                                                    -fx-text-fill: #7a5900; -fx-font-size: 12px; -fx-cursor: hand;" text="Khóa tài khoản" />
                                                    <Button fx:id="grantAdminButton" disable="true" mnemonicParsing="false" onAction="#handleGrantAdmin" prefHeight="34.0" style="-fx-background-color: #f0f6ff;                                                                    -fx-border-color: #0277bd; -fx-border-width: 1.5;                                                                    -fx-border-radius: 8; -fx-background-radius: 8;                                                                    -fx-text-fill: #0277bd; -fx-font-size: 12px; -fx-cursor: hand;" text="Cấp quyền admin" />
                                                </HBox>

                                                <TableView fx:id="userTable" style="-fx-background-radius: 8; -fx-border-color: #ccdff2;                                                                   -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="userUsernameColumn" prefWidth="180.0" text="Tên đăng nhập" />
                                                        <TableColumn fx:id="userFullNameColumn" prefWidth="220.0" text="Họ tên" />
                                                        <TableColumn fx:id="userRoleColumn" prefWidth="160.0" text="Vai trò" />
                                                        <TableColumn fx:id="userStatusColumn" prefWidth="140.0" text="Trạng thái" />
                                                    </columns>
                                                </TableView>
                                            </VBox>
                                        </Tab>

                                        <!-- Admin sub-tab: Sản phẩm -->
                                        <Tab text="Quản lý sản phẩm">
                                            <VBox spacing="12.0">
                                                <padding>
                                                    <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                                                </padding>

                                                <Label style="-fx-font-size: 15px; -fx-font-weight: bold;                                                               -fx-text-fill: #01294e;                                                               -fx-font-family: 'Segoe UI Semibold', SansSerif;" text="Quản lý sản phẩm" />

                                                <TableView fx:id="adminProductTable" prefHeight="200.0" style="-fx-background-radius: 8; -fx-border-color: #ccdff2;                                                                   -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="adminProductNameColumn" prefWidth="240.0" text="Sản phẩm" />
                                                        <TableColumn fx:id="adminProductPriceColumn" prefWidth="150.0" text="Giá hiện tại" />
                                                        <TableColumn fx:id="adminProductStatusColumn" prefWidth="140.0" text="Trạng thái" />
                                                        <TableColumn fx:id="adminProductSellerColumn" prefWidth="170.0" text="Người bán" />
                                                        <TableColumn fx:id="adminProductEndTimeColumn" prefWidth="170.0" text="Kết thúc" />
                                                    </columns>
                                                </TableView>

                                                <!-- Edit form card -->
                                                <VBox style="-fx-background-color: #f8fbff;                                                              -fx-border-color: #b0cceb; -fx-border-width: 1.5;                                                              -fx-border-radius: 10; -fx-background-radius: 10;                                                              -fx-padding: 12;">
                                                    <GridPane hgap="10.0" vgap="8.0">
                                                        <Label style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#1e3f60;" text="Tên sản phẩm:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                                        <TextField fx:id="adminItemNameField" style="-fx-background-color:#f0f6ff; -fx-border-color:#b0cceb; -fx-border-radius:8; -fx-background-radius:8; -fx-border-width:1.5;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                                        <Label style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#1e3f60;" text="Giá khởi điểm:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                                        <TextField fx:id="adminItemStartingPriceField" style="-fx-background-color:#f0f6ff; -fx-border-color:#b0cceb; -fx-border-radius:8; -fx-background-radius:8; -fx-border-width:1.5;" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                                        <Label style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#1e3f60;" text="Bắt đầu:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                                        <TextField fx:id="adminItemStartTimeField" style="-fx-background-color:#f0f6ff; -fx-border-color:#b0cceb; -fx-border-radius:8; -fx-background-radius:8; -fx-border-width:1.5;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                        <Label style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#1e3f60;" text="Kết thúc:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                                        <TextField fx:id="adminItemEndTimeField" style="-fx-background-color:#f0f6ff; -fx-border-color:#b0cceb; -fx-border-radius:8; -fx-background-radius:8; -fx-border-width:1.5;" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                                                        <Label style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#1e3f60;" text="Mô tả:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                                        <TextArea fx:id="adminItemDescriptionArea" prefRowCount="3" style="-fx-background-color:#f0f6ff; -fx-border-color:#b0cceb; -fx-border-radius:8; -fx-background-radius:8; -fx-border-width:1.5;" wrapText="true" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2" />

                                                        <Label style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#1e3f60;" text="Gia hạn đến:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                                        <TextField fx:id="adminExtendEndTimeField" promptText="yyyy-MM-dd HH:mm" style="-fx-background-color:#f0f6ff; -fx-border-color:#b0cceb; -fx-border-radius:8; -fx-background-radius:8; -fx-border-width:1.5;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                          <columnConstraints>
                                             <ColumnConstraints />
                                             <ColumnConstraints />
                                             <ColumnConstraints />
                                             <ColumnConstraints />
                                          </columnConstraints>
                                          <rowConstraints>
                                             <RowConstraints />
                                             <RowConstraints />
                                             <RowConstraints />
                                             <RowConstraints />
                                          </rowConstraints>
                                                    </GridPane>
                                                </VBox>

                                                <HBox spacing="8.0">
                                                    <Button fx:id="adminUpdateItemButton" disable="true" mnemonicParsing="false" onAction="#handleAdminUpdateItem" prefHeight="34.0" style="-fx-background-color: #f0f6ff;                                                                    -fx-border-color: #0277bd; -fx-border-width: 1.5;                                                                    -fx-border-radius: 8; -fx-background-radius: 8;                                                                    -fx-text-fill: #0277bd; -fx-font-size: 12px; -fx-cursor: hand;" text="Chỉnh sửa thông tin" />
                                                    <Button fx:id="adminCancelItemButton" disable="true" mnemonicParsing="false" onAction="#handleAdminCancelItem" prefHeight="34.0" style="-fx-background-color: #fffbf0;                                                                    -fx-border-color: #d4a017; -fx-border-width: 1.5;                                                                    -fx-border-radius: 8; -fx-background-radius: 8;                                                                    -fx-text-fill: #7a5900; -fx-font-size: 12px; -fx-cursor: hand;" text="Hủy phiên đấu giá" />
                                                    <Button fx:id="adminExtendItemButton" disable="true" mnemonicParsing="false" onAction="#handleAdminExtendItem" prefHeight="34.0" style="-fx-background-color: #f0f6ff;                                                                    -fx-border-color: #0277bd; -fx-border-width: 1.5;                                                                    -fx-border-radius: 8; -fx-background-radius: 8;                                                                    -fx-text-fill: #0277bd; -fx-font-size: 12px; -fx-cursor: hand;" text="Gia hạn thêm thời gian" />
                                                    <Button fx:id="adminDeleteItemButton" disable="true" mnemonicParsing="false" onAction="#handleAdminDeleteItem" prefHeight="34.0" style="-fx-background-color: #fff0f0;                                                                    -fx-border-color: #e05a5a; -fx-border-width: 1.5;                                                                    -fx-border-radius: 8; -fx-background-radius: 8;                                                                    -fx-text-fill: #c0392b; -fx-font-size: 12px; -fx-cursor: hand;" text="Xóa sản phẩm" />
                                                </HBox>
                                            </VBox>
                                        </Tab>
                                    </tabs>
                                </TabPane>
                            </VBox>
                        </Tab>

                    </tabs>
                </TabPane>

                <Region prefHeight="10.0" />

                <!-- System message bar -->
                <Label fx:id="systemMessageLabel" maxWidth="Infinity" minHeight="40.0" style="-fx-background-color: #e3f0ff;                               -fx-border-color: #0277bd; -fx-border-width: 1.5;                               -fx-background-radius: 8; -fx-border-radius: 8;                               -fx-padding: 10 14;                               -fx-text-fill: #01294e;                               -fx-font-weight: bold;                               -fx-font-family: 'Segoe UI', SansSerif;" wrapText="true" />
            </VBox>
        </center>
    </BorderPane>

</StackPane>
