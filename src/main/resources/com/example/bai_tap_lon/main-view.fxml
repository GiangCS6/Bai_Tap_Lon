<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1120.0" style="-fx-background-color: #f4f6f8;"
           xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.bai_tap_lon.controller.MainController">

    <VBox fx:id="authPane" alignment="CENTER" spacing="18.0" style="-fx-background-color: #eef2f6;">
        <VBox maxWidth="420.0" spacing="14.0" style="-fx-background-color: white; -fx-padding: 28; -fx-background-radius: 8;">
            <Label style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1f3349;" text="ĐẤU GIÁ UY TÍN" />
            <Label style="-fx-text-fill: #607080;" text="Chọn cách bắt đầu với hệ thống đấu giá." />

            <VBox fx:id="authChoicePane" spacing="10.0">
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showLoginForm"
                        style="-fx-background-color: #265f9f; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="Đăng nhập" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showSignupForm"
                        style="-fx-background-color: transparent; -fx-border-color: #265f9f; -fx-text-fill: #265f9f; -fx-font-weight: bold;"
                        text="Đăng ký" />
            </VBox>

            <VBox fx:id="loginPane" managed="false" spacing="10.0" visible="false">
                <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Đăng nhập" />
                <TextField fx:id="loginUsernameField" promptText="Tên đăng nhập" />
                <PasswordField fx:id="loginPasswordField" promptText="Mật khẩu" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin"
                        style="-fx-background-color: #265f9f; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="Đăng nhập" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showAuthChoice"
                        style="-fx-background-color: transparent; -fx-text-fill: #607080;"
                        text="Quay lại" />
            </VBox>

            <VBox fx:id="signupPane" managed="false" spacing="10.0" visible="false">
                <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Đăng ký tài khoản" />
                <TextField fx:id="signupFullNameField" promptText="Họ và tên" />
                <TextField fx:id="signupUsernameField" promptText="Tên đăng nhập" />
                <PasswordField fx:id="signupPasswordField" promptText="Mật khẩu" />
                <ComboBox fx:id="signupRoleBox" maxWidth="Infinity" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSignup"
                        style="-fx-background-color: #265f9f; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="Đăng ký" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showAuthChoice"
                        style="-fx-background-color: transparent; -fx-text-fill: #607080;"
                        text="Quay lại" />
            </VBox>

            <Separator />
            <Label fx:id="authMessageLabel" wrapText="true" style="-fx-text-fill: #b42318;" />
        </VBox>
    </VBox>

    <BorderPane fx:id="appPane" managed="false" visible="false">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: #1f3349;">
                <padding>
                    <Insets bottom="14.0" left="18.0" right="18.0" top="14.0" />
                </padding>
                <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;" text="ĐẤU GIÁ UY TÍN" />
                <Label fx:id="currentUserLabel" style="-fx-text-fill: #d7e3ef;" text="Chưa đăng nhập" />
                <HBox HBox.hgrow="ALWAYS" />
                <Button fx:id="logoutButton" disable="true" mnemonicParsing="false" onAction="#handleLogout" text="Đăng xuất" />
            </HBox>
        </top>

        <center>
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                </padding>
                <TabPane fx:id="mainTabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="Sản phẩm đấu giá">
                            <VBox spacing="12.0">
                                <padding>
                                    <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                                </padding>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Sản phẩm đấu giá" />
                                    <HBox HBox.hgrow="ALWAYS" />
                                    <Button mnemonicParsing="false" onAction="#handleRefresh" text="Cập nhật trạng thái" />
                                </HBox>
                                <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                                    <TableView fx:id="auctionTable" HBox.hgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="nameColumn" prefWidth="320.0" text="Sản phẩm" />
                                            <TableColumn fx:id="priceColumn" prefWidth="180.0" text="Giá hiện tại" />
                                            <TableColumn fx:id="statusColumn" prefWidth="160.0" text="Trạng thái" />
                                            <TableColumn fx:id="ownerColumn" prefWidth="180.0" text="Chủ sở hữu" />
                                            <TableColumn fx:id="endTimeColumn" prefWidth="190.0" text="Kết thúc" />
                                        </columns>
                                    </TableView>

                                    <VBox fx:id="sellerPane" prefWidth="320.0" spacing="10.0" style="-fx-background-color: white; -fx-padding: 14;">
                                        <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Thêm sản phẩm đấu giá" />
                                        <TextField fx:id="itemNameField" promptText="Tên sản phẩm" />
                                        <TextArea fx:id="itemDescriptionArea" prefRowCount="4" promptText="Mô tả" wrapText="true" />
                                        <TextField fx:id="itemStartingPriceField" promptText="Giá khởi điểm" />
                                        <Label text="Định dạng thời gian: yyyy-MM-dd HH:mm." style="-fx-text-fill: #607080;" />
                                        <TextField fx:id="itemStartTimeField" promptText="Thời gian bắt đầu" />
                                        <TextField fx:id="itemEndTimeField" promptText="Thời gian kết thúc" />
                                        <Button fx:id="addItemButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleAddItem" text="Thêm sản phẩm" />
                                        <Separator />
                                        <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Sửa hoặc xóa sản phẩm đã chọn" />
                                        <Button fx:id="updateItemButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleUpdateItem" text="Sửa sản phẩm" />
                                        <Button fx:id="deleteItemButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleDeleteItem" text="Xóa sản phẩm" />
                                    </VBox>
                                </HBox>
                            </VBox>
                        </Tab>

                        <Tab text="Chi tiết sản phẩm">
                            <VBox spacing="12.0" style="-fx-background-color: white;">
                                <padding>
                                    <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                                </padding>
                                <Label fx:id="detailNameLabel" style="-fx-font-size: 22; -fx-font-weight: bold;" text="Chưa chọn phiên" />
                                <Button fx:id="watchItemButton" disable="true" managed="false" mnemonicParsing="false"
                                        onAction="#handleToggleWatch" text="Theo doi san pham" visible="false" />
                                <Label fx:id="detailDescriptionLabel" wrapText="true" />
                                <GridPane hgap="12.0" vgap="9.0">
                                    <Label text="Người bán:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <Label fx:id="detailSellerLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                    <Label text="Bắt đầu:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <Label fx:id="detailStartLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label text="Kết thúc:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                    <Label fx:id="detailEndLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Label text="Trạng thái:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                    <Label fx:id="detailStatusLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    <Label text="Giá cao nhất:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                    <Label fx:id="detailCurrentPriceLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                    <Label text="Người dẫn đầu:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                    <Label fx:id="detailLeaderLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                    <Label text="Giá khởi điểm:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                                    <Label fx:id="detailStartingPriceLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                                </GridPane>
                                <Label style="-fx-font-weight: bold;" text="Lịch sử đấu giá" />
                                <ListView fx:id="bidHistoryList" VBox.vgrow="ALWAYS" />
                            </VBox>
                        </Tab>

                        <Tab fx:id="liveAuctionTab" text="Đấu giá trực tiếp">
                            <VBox spacing="14.0" style="-fx-background-color: white;">
                                <padding>
                                    <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                                </padding>
                                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Đặt giá cho phiên đang diễn ra" />
                                <Label wrapText="true" text="Chọn sản phẩm muốn đấu giá, sau đó nhập giá cao hơn giá hiện tại." />
                                <ComboBox fx:id="bidItemComboBox" maxWidth="420.0" promptText="Chọn sản phẩm đấu giá" />
                                <HBox maxWidth="420.0" spacing="8.0">
                                    <TextField fx:id="bidAmountField" promptText="Giá muốn đặt" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="bidButton" mnemonicParsing="false" onAction="#handlePlaceBid"
                                            style="-fx-background-color: #265f9f; -fx-text-fill: white;"
                                            text="Đặt giá" />
                                </HBox>
                                <Separator />
                                <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="San pham dang theo doi" />
                                <ListView fx:id="watchedItemList" prefHeight="180.0" VBox.vgrow="ALWAYS" />
                            </VBox>
                        </Tab>

                        <Tab text="Thong bao">
                            <VBox spacing="12.0" style="-fx-background-color: white;">
                                <padding>
                                    <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                                </padding>
                                <Label fx:id="notificationSummaryLabel" style="-fx-font-size: 20; -fx-font-weight: bold;" text="Thong bao" />
                                <ListView fx:id="notificationList" VBox.vgrow="ALWAYS" />
                            </VBox>
                        </Tab>

                        <Tab fx:id="adminTab" text="Quản trị viên">
                            <VBox fx:id="adminPane" spacing="12.0" style="-fx-background-color: white;">
                                <padding>
                                    <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                                </padding>
                                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                                    <tabs>
                                        <Tab text="Quản lý người dùng">
                                            <VBox spacing="12.0">
                                                <padding>
                                                    <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                                                </padding>
                                                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Quản lý người dùng" />
                                                <HBox spacing="8.0">
                                                    <Button mnemonicParsing="false" onAction="#handleRefreshUsers" text="Xem danh sách người dùng" />
                                                    <Button fx:id="deleteUserButton" disable="true" mnemonicParsing="false" onAction="#handleDeleteUser" text="Xóa tài khoản" />
                                                    <Button fx:id="toggleUserLockButton" disable="true" mnemonicParsing="false" onAction="#handleToggleUserLock" text="Khóa tài khoản" />
                                                    <Button fx:id="grantAdminButton" disable="true" mnemonicParsing="false" onAction="#handleGrantAdmin" text="Cấp quyền admin" />
                                                </HBox>
                                                <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="userUsernameColumn" prefWidth="180.0" text="Tên đăng nhập" />
                                                        <TableColumn fx:id="userFullNameColumn" prefWidth="220.0" text="Họ tên" />
                                                        <TableColumn fx:id="userRoleColumn" prefWidth="180.0" text="Vai trò" />
                                                        <TableColumn fx:id="userStatusColumn" prefWidth="140.0" text="Trạng thái" />
                                                    </columns>
                                                </TableView>
                                            </VBox>
                                        </Tab>

                                        <Tab text="Quản lý sản phẩm">
                                            <VBox spacing="12.0">
                                                <padding>
                                                    <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                                                </padding>
                                                <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Quản lý sản phẩm" />
                                                <TableView fx:id="adminProductTable" prefHeight="220.0" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="adminProductNameColumn" prefWidth="260.0" text="Sản phẩm" />
                                                        <TableColumn fx:id="adminProductPriceColumn" prefWidth="160.0" text="Giá hiện tại" />
                                                        <TableColumn fx:id="adminProductStatusColumn" prefWidth="150.0" text="Trạng thái" />
                                                        <TableColumn fx:id="adminProductSellerColumn" prefWidth="180.0" text="Người bán" />
                                                        <TableColumn fx:id="adminProductEndTimeColumn" prefWidth="180.0" text="Kết thúc" />
                                                    </columns>
                                                </TableView>

                                                <GridPane hgap="10.0" vgap="8.0">
                                                    <Label text="Tên sản phẩm:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                                    <TextField fx:id="adminItemNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                                    <Label text="Giá khởi điểm:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                                    <TextField fx:id="adminItemStartingPriceField" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                                    <Label text="Bắt đầu:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                                    <TextField fx:id="adminItemStartTimeField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                    <Label text="Kết thúc:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                                    <TextField fx:id="adminItemEndTimeField" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                                                    <Label text="Mô tả:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                                    <TextArea fx:id="adminItemDescriptionArea" prefRowCount="3" wrapText="true"
                                                              GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2" />

                                                    <Label text="Gia hạn đến:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                                    <TextField fx:id="adminExtendEndTimeField" promptText="yyyy-MM-dd HH:mm"
                                                               GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                                </GridPane>

                                                <HBox spacing="8.0">
                                                    <Button fx:id="adminUpdateItemButton" disable="true" mnemonicParsing="false" onAction="#handleAdminUpdateItem" text="Chỉnh sửa thông tin sản phẩm" />
                                                    <Button fx:id="adminCancelItemButton" disable="true" mnemonicParsing="false" onAction="#handleAdminCancelItem" text="Hủy phiên đấu giá" />
                                                    <Button fx:id="adminExtendItemButton" disable="true" mnemonicParsing="false" onAction="#handleAdminExtendItem" text="Gia hạn thêm thời gian" />
                                                    <Button fx:id="adminDeleteItemButton" disable="true" mnemonicParsing="false" onAction="#handleAdminDeleteItem" text="Xóa sản phẩm" />
                                                </HBox>
                                            </VBox>
                                        </Tab>
                                    </tabs>
                                </TabPane>
                            </VBox>
                        </Tab>
                    </tabs>
                </TabPane>
                <Label fx:id="systemMessageLabel" minHeight="42.0" maxWidth="Infinity" wrapText="true"
                       style="-fx-background-color: #fff4cc; -fx-border-color: #d18b00; -fx-border-width: 1.5; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 10 14; -fx-text-fill: #6f4700; -fx-font-weight: bold;" />
            </VBox>
        </center>
    </BorderPane>
</StackPane>
