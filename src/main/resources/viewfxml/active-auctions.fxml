<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="bai_tap_lon.client.controller.ActiveAuctionsController"
            styleClass="root-pane"
            prefWidth="1550"
            prefHeight="900"
            stylesheets="@home-view.css,@active-auctions-view.css">

    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="10" right="25" bottom="10" left="25"/>
            </padding>

            <Label text="BidderHolic" styleClass="logo"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- =========================  ADMIN NAV  ========================= -->
            <HBox fx:id="adminNav" spacing="20" alignment="CENTER" visible="false" managed="false">
                <Button text="Auction List"    styleClass="nav-link"                onAction="#goToAuctionList"/>
                <Button text="Active Auction"  styleClass="nav-link, active-link"/>
                <Button text="User Management" styleClass="nav-link"                onAction="#goToUserManagement"/>
                <Button text="Auction Approval" styleClass="nav-link"               onAction="#goToAuctionApproval"/>
                <Button text="Reports"         styleClass="nav-link"                onAction="#goToReports"/>
                <Button text="System Settings" styleClass="nav-link"                onAction="#goToSystemSettings"/>
            </HBox>

            <!-- =========================  SELLER NAV  ======================== -->
            <HBox fx:id="sellerNav" spacing="20" alignment="CENTER" visible="false" managed="false">
                <Button text="Auction List"    styleClass="nav-link"                onAction="#goToAuctionList"/>
                <Button text="Active Auction"  styleClass="nav-link, active-link"/>
                <Button text="Selling History" styleClass="nav-link"                onAction="#goToSellerHistory"/>
                <Button text="Add Item"        styleClass="nav-link"                onAction="#goToAddItem"/>

            </HBox>

            <!-- =========================  BIDDER NAV  ======================== -->
            <HBox fx:id="bidderNav" spacing="20" alignment="CENTER" visible="false" managed="false">
                <Button text="Auction List"    styleClass="nav-link"                onAction="#goToAuctionList"/>
                <Button text="Active Auction"  styleClass="nav-link, active-link"/>
                <Button text="Bidding History" styleClass="nav-link"                onAction="#goToBiddingHistory"/>
                <Button text="Watchlist"       styleClass="nav-link"                onAction="#goToWatchlist"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="15" alignment="CENTER_RIGHT" styleClass="user-section">
                <HBox spacing="12" alignment="CENTER">
                    <Button fx:id="walletBtn" text="💳" styleClass="icon-btn" onAction="#goToWallet"/>
                    <StackPane>
                        <Button fx:id="bellBtn" text="🔔" styleClass="icon-btn" onAction="#onBell"/>
                        <Label fx:id="notificationBadge" text="0" styleClass="badge"
                               StackPane.alignment="TOP_RIGHT"/>
                    </StackPane>
                </HBox>

                <Separator orientation="VERTICAL" prefHeight="20" styleClass="sep"/>

                <HBox spacing="8" alignment="CENTER">
                    <Label fx:id="userNameLabel" text="Guest" styleClass="name"/>
                    <MenuButton mnemonicParsing="false" styleClass="avatar-menu">
                        <graphic>
                            <Circle radius="14" fill="#00cda5"/>
                        </graphic>
                        <items>
                            <MenuItem text="Profile" onAction="#goToProfile"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Logout" onAction="#onLogout"/>
                        </items>
                    </MenuButton>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="18" styleClass="main-content">
            <padding>
                <Insets top="20" right="24" bottom="20" left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="4">
                    <Label text="ACTIVE AUCTIONS"      styleClass="section-title"/>
                    <Label text="Real-time bidding updates" styleClass="sub-title"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER" spacing="8" styleClass="live-pill">
                    <Circle radius="4" fill="#ef4444"/>
                    <Label text="LIVE NOW" styleClass="live-pill-text"/>
                </HBox>
            </HBox>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS"
                        styleClass="transparent-scroll">
                <content>
                    <FlowPane fx:id="auctionContainer"
                              hgap="22"
                              vgap="22"
                              styleClass="auction-grid">
                        <padding>
                            <Insets top="4" right="2" bottom="14" left="2"/>
                        </padding>
                    </FlowPane>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
