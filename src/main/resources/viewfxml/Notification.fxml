<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="bai_tap_lon.client.controller.NotificationController"
      spacing="12"
      style="-fx-background-color: #0A192F; -fx-border-color: #1E3A5F;
             -fx-border-width: 1; -fx-border-radius: 14; -fx-background-radius: 14;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 18, 0.2, 0, 6);
             -fx-pref-width: 380;">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Thông báo"
               style="-fx-text-fill: #E2E8F0; -fx-font-size: 14px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="clearAllBtn"
                text="Xóa tất cả"
                onAction="#onClearAll"
                style="-fx-background-color: transparent; -fx-text-fill: #64FFDA;
                       -fx-font-size: 12px; -fx-cursor: hand;"/>
    </HBox>

    <ScrollPane fitToWidth="true"
                prefHeight="420"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                style="-fx-background-color: transparent; -fx-background-insets: 0;">
        <content>
            <VBox fx:id="notificationListBox" spacing="10"/>
        </content>
    </ScrollPane>
</VBox>
