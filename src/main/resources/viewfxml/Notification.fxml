<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="520.0" prefWidth="397.0" spacing="12" styleClass="notif-panel" stylesheets="@notification.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bai_tap_lon.client.controller.NotificationController">
    <padding>
        <Insets bottom="16" left="16" right="16" top="16" />
    </padding>

    <!-- Header: title + clear all -->
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label styleClass="notif-panel-title" text="Thông báo" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="clearAllBtn" onAction="#onClearAll" styleClass="notif-clear-btn" text="Xóa tất cả" />
    </HBox>

    <!-- Scrollable notification list -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="420" styleClass="notif-scroll" vbarPolicy="AS_NEEDED">
        <content>
            <VBox fx:id="notificationListBox" spacing="10" />
        </content>
    </ScrollPane>
</VBox>
