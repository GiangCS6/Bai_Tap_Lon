<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane styleClass="root-pane" stylesheets="@home-view.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bai_tap_lon.client.controller.WatchlistController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="navbar">
            <padding><Insets bottom="10" left="25" right="25" top="10" /></padding>

            <Label styleClass="logo" text="BidderHolic" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- =========================  ADMIN NAV  ========================= -->
            <HBox fx:id="adminNav" alignment="CENTER" managed="false" spacing="20" visible="false">
                <Button onAction="#goToAuctionList" styleClass="nav-link" text="Auction List" />
                <Button onAction="#goToActiveAuctions" styleClass="nav-link" text="Active Auction" />
                <Button onAction="#goToUserManagement" styleClass="nav-link" text="User Management" />
                <Button onAction="#goToReports" styleClass="nav-link" text="Reports" />
                <Button onAction="#goToSystemSettings" styleClass="nav-link" text="System Settings" />
            </HBox>

            <!-- =========================  SELLER NAV  ======================== -->
            <HBox fx:id="sellerNav" alignment="CENTER" managed="false" spacing="20" visible="false">
                <Button onAction="#goToAuctionList" styleClass="nav-link" text="Auction List" />
                <Button onAction="#goToActiveAuctions" styleClass="nav-link" text="Active Auction" />
                <Button onAction="#goToSellerHistory" styleClass="nav-link" text="Selling History" />
                <Button onAction="#goToAddItem" styleClass="nav-link" text="Add Item" />
            </HBox>

            <!-- =========================  BIDDER NAV  ======================== -->
            <HBox fx:id="bidderNav" alignment="CENTER" managed="false" spacing="20" visible="false">
                <Button onAction="#goToAuctionList" styleClass="nav-link" text="Auction List" />
                <Button onAction="#goToActiveAuctions" styleClass="nav-link" text="Active Auction" />
                <Button onAction="#goToBiddingHistory" styleClass="nav-link" text="Bidding History" />
                <Button styleClass="nav-link, active-link" text="Watchlist" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="15" styleClass="user-section">
                <HBox alignment="CENTER" spacing="12">
                    <Button fx:id="walletBtn" onAction="#goToWallet" styleClass="icon-btn" text="💳" />
                    <StackPane>
                        <Button fx:id="bellBtn" styleClass="icon-btn" text="🔔" onAction="#onBell" />
                        <Label fx:id="notificationBadge" styleClass="badge" text="0" StackPane.alignment="TOP_RIGHT" />
                    </StackPane>
                </HBox>

                <Separator orientation="VERTICAL" prefHeight="20" styleClass="sep" />

                <HBox alignment="CENTER" spacing="8">
                    <Label fx:id="userNameLabel" styleClass="name" text="Guest" />
                    <MenuButton mnemonicParsing="false" styleClass="avatar-menu">
                        <graphic>
                            <Circle fill="#00cda5" radius="14" />
                        </graphic>
                        <items>
                            <MenuItem onAction="#goToProfile" text="Profile" />
                            <SeparatorMenuItem />
                            <MenuItem onAction="#onLogout" text="Logout" />
                        </items>
                    </MenuButton>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="25" styleClass="main-content">
            <padding><Insets bottom="30" left="50" right="50" top="30" /></padding>

            <VBox alignment="CENTER" spacing="15">
                <Label styleClass="nav-link" text="WATCHLIST" />
            </VBox>

            <VBox spacing="15" styleClass="filter-section">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <TextField fx:id="searchField" promptText="Search by item name..." styleClass="input-field" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnRefresh" onAction="#onRefresh" prefWidth="120" styleClass="btn-primary" text="Refresh" />
                </HBox>
            </VBox>

            <TableView fx:id="auctionTable" styleClass="dark-table" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label styleClass="placeholder-label" text="Watchlist trống. Hãy thêm phiên bằng nút Care/Join/Place Bid." />
                </placeholder>
                <columns>
                    <TableColumn fx:id="colOrder" prefWidth="60" text="#" />
                    <TableColumn fx:id="colName" prefWidth="200" text="Name" />
                    <TableColumn fx:id="colCategory" prefWidth="130" text="Category" />
                    <TableColumn fx:id="colStatus" prefWidth="120" text="Status" />
                    <TableColumn fx:id="colCurrentPrice" prefWidth="150" text="Current Price" />
                    <TableColumn fx:id="colStartTime" prefWidth="160" text="Start Time" />
                    <TableColumn fx:id="colEndTime" prefWidth="160" text="End Time" />
                    <TableColumn fx:id="colAction" prefWidth="120" text="Action" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
