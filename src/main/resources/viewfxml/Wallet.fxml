<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="328.0" prefWidth="330.0" spacing="14" styleClass="wallet-panel" stylesheets="@wallet.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bai_tap_lon.client.controller.WalletController">
    <padding>
        <Insets bottom="18" left="18" right="18" top="18" />
    </padding>

    <!-- Header: tiêu đề + nút đóng -->
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label styleClass="wallet-title" text="Ví của tôi" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="closeBtn" onAction="#onClose" styleClass="wallet-close-btn" text="✕" />
    </HBox>

    <!-- Balance card -->
    <VBox alignment="CENTER_LEFT" spacing="4" styleClass="balance-card">
        <Label styleClass="balance-hint" text="Số dư hiện tại" />
        <Label fx:id="balanceLabel" styleClass="balance-amount" text="0 đ" />
        <Label fx:id="roleHintLabel" styleClass="role-hint" text="" />
    </VBox>

    <!-- Input -->
    <VBox spacing="6">
        <Label styleClass="input-label" text="Số tiền (VNĐ)" />
        <TextField fx:id="amountField" promptText="VD: 100000" styleClass="wallet-input" />
    </VBox>

    <!-- Action buttons -->
    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="depositBtn" maxWidth="Infinity" onAction="#onDeposit" styleClass="btn-deposit" text="Nạp" HBox.hgrow="ALWAYS" />
        <Button fx:id="withdrawBtn" maxWidth="Infinity" onAction="#onWithdraw" styleClass="btn-withdraw" text="Rút" HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- Status message -->
    <Label fx:id="statusLabel" styleClass="wallet-status" text="" wrapText="true" />

    <!-- Disclaimer -->
    <Label styleClass="wallet-disclaimer" text="* Tối thiểu 1.000 VNĐ mỗi giao dịch" />
</VBox>
