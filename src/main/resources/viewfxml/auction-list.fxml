<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane styleClass="root-pane" stylesheets="@home-view.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bai_tap_lon.client.controller.AuctionListController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="navbar">
            <padding><Insets bottom="10" left="25" right="25" top="10" /></padding>

            <Label styleClass="logo" text="CÔNG TY 4N" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- =========================  ADMIN NAV  ========================= -->
            <HBox fx:id="adminNav" alignment="CENTER" managed="false" spacing="20" visible="false">
                <Button styleClass="nav-link, active-link" text="Auction List" />
                <Button onAction="#goToActiveAuctions" styleClass="nav-link" text="Active Auction" />
                <Button onAction="#goToUserManagement" styleClass="nav-link" text="User Management" />
                <Button onAction="#goToReports" styleClass="nav-link" text="Reports" />
                <Button onAction="#goToSystemSettings" styleClass="nav-link" text="System Settings" />
            </HBox>

            <!-- =========================  SELLER NAV  ======================== -->
            <HBox fx:id="sellerNav" alignment="CENTER" managed="false" spacing="20" visible="false">
                <Button styleClass="nav-link, active-link" text="Auction List" />
                <Button onAction="#goToActiveAuctions" styleClass="nav-link" text="Active Auction" />
                <Button onAction="#goToSellerHistory" styleClass="nav-link" text="Selling History" />
                <Button onAction="#goToAddItem" styleClass="nav-link" text="Add Item" />
            </HBox>

            <!-- =========================  BIDDER NAV  ======================== -->
            <HBox fx:id="bidderNav" alignment="CENTER" managed="false" spacing="20" visible="false">
                <Button styleClass="nav-link, active-link" text="Auction List" />
                <Button onAction="#goToActiveAuctions" styleClass="nav-link" text="Active Auction" />
                <Button onAction="#goToBiddingHistory" styleClass="nav-link" text="Bidding History" />
                <Button onAction="#goToWatchlist" styleClass="nav-link" text="Watchlist" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="15" styleClass="user-section">
                <HBox alignment="CENTER" spacing="12">
                    <Button fx:id="walletBtn" onAction="#goToWallet" styleClass="icon-btn" text="💳" />
                    <StackPane>
                        <Button fx:id="bellBtn" onAction="#onBell" styleClass="icon-btn" text="🔔" />
                        <Label fx:id="notificationBadge" styleClass="badge" text="0" StackPane.alignment="TOP_RIGHT" />
                    </StackPane>
                </HBox>

                <Separator orientation="VERTICAL" prefHeight="20" styleClass="sep" />

                <HBox alignment="CENTER" spacing="8">
                    <Label fx:id="userNameLabel" styleClass="name" text="Guest" />
                    <MenuButton mnemonicParsing="false" styleClass="avatar-menu">
                        <graphic>
                            <Circle fill="#2e8b40" radius="14" />
                        </graphic>
                        <items>
                            <MenuItem onAction="#goToProfile" text="Profile" />
                            <SeparatorMenuItem />
                            <MenuItem onAction="#onLogout" text="Logout" />
                        </items>
                    </MenuButton>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="25" styleClass="main-content">
            <padding><Insets bottom="30" left="50" right="50" top="30" /></padding>

            <!-- Title + Category toggle -->
            <VBox alignment="CENTER" spacing="15">
                <Label styleClass="section-title" text="AUCTION LIST" />
                <HBox alignment="CENTER" maxWidth="355.0" prefHeight="35.0" prefWidth="355.0" styleClass="toggle-container">
                    <Button fx:id="btnCatAll" onAction="#onCategoryAll" styleClass="toggle-btn, active-toggle" text="All" />
                    <Button fx:id="btnCatElectronics" onAction="#onCategoryElectronics" styleClass="toggle-btn" text="Electronics" />
                    <Button fx:id="btnCatVehicles" onAction="#onCategoryVehicles" prefHeight="31.0" prefWidth="111.0" styleClass="toggle-btn" text="Vehicles" />
                    <Button fx:id="btnCatArts" onAction="#onCategoryArts" prefHeight="31.0" prefWidth="66.0" styleClass="toggle-btn" text="Arts" />
                </HBox>
            </VBox>

            <!-- Search & filter -->
            <VBox spacing="15" styleClass="filter-section">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <TextField fx:id="searchField" promptText="Search by item name..." styleClass="input-field" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnSearch" onAction="#onSearch" prefWidth="120" styleClass="btn-primary" text="Search" />
                    <Button fx:id="btnRefresh" onAction="#onRefresh" prefWidth="120" styleClass="btn-primary" text="Refresh" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label styleClass="filter-label" text="Status:" />
                    <ComboBox fx:id="statusFilter" prefWidth="260" promptText="All statuses" styleClass="input-combo" />
                </HBox>
            </VBox>

            <!-- Data table -->
            <TableView fx:id="auctionTable" styleClass="dark-table" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label styleClass="placeholder-label" text="No content in table" />
                </placeholder>
                <columns>
                    <TableColumn fx:id="colOrder" prefWidth="60" text="#" />
                    <TableColumn fx:id="colName" prefWidth="200" text="Name" />
                    <TableColumn fx:id="colCategory" prefWidth="130" text="Category" />
                    <TableColumn fx:id="colStatus" prefWidth="120" text="Status" />
                    <TableColumn fx:id="colCurrentPrice" prefWidth="150" text="Current Price" />
                    <TableColumn fx:id="colStartTime" prefWidth="160" text="Start Time" />
                    <TableColumn fx:id="colEndTime" prefWidth="160" text="End Time" />
                    <TableColumn fx:id="colAction" prefWidth="180" text="Action" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
