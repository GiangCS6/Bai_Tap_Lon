<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="bai_tap_lon.client.controller.BiddingController"
        stylesheets="@../viewfxml/bidding.css">

    <top>
        <VBox styleClass="top-bar">

            <!-- Row 1: back + item name + status -->
            <HBox styleClass="header-row" alignment="CENTER_LEFT" spacing="16">
                <Button fx:id="btnBack" text="← Back" onAction="#onBack" styleClass="btn-ghost"/>

                <Label fx:id="lblItemName" text="Item name" styleClass="item-name"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Status badge -->
                <HBox alignment="CENTER" spacing="6" styleClass="status-badge">
                    <Circle fx:id="dotStatus" radius="5" fill="#22c55e"/>
                    <Label fx:id="lblStatus" text="RUNNING" styleClass="status-text"/>
                </HBox>
            </HBox>

            <!-- Row 2: end time + countdown -->
            <HBox styleClass="subheader-row" alignment="CENTER_LEFT" spacing="24">
                <Label fx:id="lblEndTime" text="END: --/-- --:--" styleClass="end-time"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Time left:" styleClass="label-muted"/>
                <Label fx:id="lblCountdown" text="00:00:00" styleClass="countdown"/>
            </HBox>

        </VBox>
    </top>

    <center>
        <HBox spacing="0">

            <!-- LEFT: price + bid form + auto-bid + table -->
            <VBox styleClass="left-panel" spacing="0" prefWidth="420">

                <!-- Price card -->
                <VBox styleClass="price-card" spacing="4">
                    <Label text="CURRENT PRICE" styleClass="label-tiny"/>
                    <Label fx:id="lblCurrentPrice" text="0 ₫" styleClass="current-price"/>
                    <Label fx:id="lblLeader" text="No bids yet" styleClass="leader-name"/>
                    <Label fx:id="lblAvailableBalance" text="Available Balance: 0 ₫" styleClass="balance-label"/>
                </VBox>

                <!-- Bid input card -->
                <VBox styleClass="section-card" spacing="10">
                    <Label text="PLACE BID" styleClass="section-title"/>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="txfBidAmount"
                                   promptText="Enter amount (e.g. 500000)"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="input-field"/>
                        <Button fx:id="btnPlaceBid"
                                text="Place Bid"
                                onAction="#onPlaceBid"
                                styleClass="btn-primary"/>
                    </HBox>

                    <Label fx:id="lblBidMsg" text="" wrapText="true"
                           styleClass="msg-label" visible="false"/>
                </VBox>

                <!-- Auto-bid card -->
                <VBox styleClass="section-card" spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="AUTO BID" styleClass="section-title"/>
                        <Label fx:id="lblAutoBidStatus" text="" styleClass="autobid-badge" visible="false"/>
                    </HBox>

                    <GridPane hgap="8" vgap="8">
                        <Label text="Max price:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                               styleClass="label-form"/>
                        <TextField fx:id="txfMaxBid" promptText="e.g. 2000000"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"
                                   styleClass="input-field" GridPane.hgrow="ALWAYS"/>

                        <Label text="Increment:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                               styleClass="label-form"/>
                        <TextField fx:id="txfIncrement" promptText="e.g. 50000"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"
                                   styleClass="input-field" GridPane.hgrow="ALWAYS"/>
                    </GridPane>

                    <HBox spacing="8">
                        <Button fx:id="btnSetAutoBid" text="Enable Auto Bid"
                                onAction="#onSetAutoBid" styleClass="btn-accent"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnCancelAutoBid" text="Disable"
                                onAction="#onCancelAutoBid" styleClass="btn-ghost-sm"/>
                    </HBox>
                </VBox>

                <!-- Bid history table -->
                <VBox styleClass="section-card" VBox.vgrow="ALWAYS" spacing="8">
                    <Label text="BID HISTORY" styleClass="section-title"/>
                    <TableView fx:id="tblHistory" VBox.vgrow="ALWAYS" styleClass="bid-table">
                        <columns>
                            <TableColumn fx:id="colBidder" text="Bidder"    prefWidth="130"/>
                            <TableColumn fx:id="colAmount" text="Amount"    prefWidth="130"/>
                            <TableColumn fx:id="colTime"   text="Time"      prefWidth="80"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

            </VBox>

            <!-- RIGHT: price chart -->
            <VBox styleClass="right-panel" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
                <Label text="REALTIME PRICE CHART" styleClass="section-title"
                       style="-fx-padding: 20 24 0 24;"/>
                <LineChart fx:id="chart" VBox.vgrow="ALWAYS"
                           styleClass="price-chart"
                           style="-fx-padding: 8 16 16 16;">
                    <xAxis>
                        <NumberAxis fx:id="chartXAxis" autoRanging="false"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="chartYAxis"/>
                    </yAxis>
                </LineChart>
            </VBox>

        </HBox>
    </center>

</BorderPane>
