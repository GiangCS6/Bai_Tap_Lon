<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="900" prefWidth="1550" styleClass="root-pane" stylesheets="@home-view.css,@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bai_tap_lon.client.controller.SellerHistoryController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="navbar">
            <padding>
                <Insets bottom="10" left="25" right="25" top="10" />
            </padding>

            <Label styleClass="logo" text="CÔNG TY 4N" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- =========================  ADMIN NAV  ========================= -->
            <HBox fx:id="adminNav" alignment="CENTER" managed="false" spacing="20" visible="false">
                <Button onAction="#goToAuctionList" styleClass="nav-link" text="Auction List" />
                <Button onAction="#goToActiveAuctions" styleClass="nav-link" text="Active Auction" />
                <Button onAction="#goToUserManagement" styleClass="nav-link" text="User Management" />
                <Button onAction="#goToAuctionApproval" styleClass="nav-link" text="Auction Approval" />
                <Button onAction="#goToReports" styleClass="nav-link" text="Reports" />
                <Button onAction="#goToSystemSettings" styleClass="nav-link" text="System Settings" />
            </HBox>

            <!-- =========================  SELLER NAV  ======================== -->
            <HBox fx:id="sellerNav" alignment="CENTER" managed="false" spacing="20" visible="false">
                <Button onAction="#goToAuctionList" styleClass="nav-link" text="Auction List" />
                <Button onAction="#goToActiveAuctions" styleClass="nav-link" text="Active Auction" />
                <Button styleClass="nav-link, active-link" text="Selling History" />
                <Button onAction="#goToAddItem" styleClass="nav-link" text="Add Item" />
            </HBox>

            <!-- =========================  BIDDER NAV  ======================== -->
            <HBox fx:id="bidderNav" alignment="CENTER" managed="false" spacing="20" visible="false">
                <Button onAction="#goToAuctionList" styleClass="nav-link" text="Auction List" />
                <Button onAction="#goToActiveAuctions" styleClass="nav-link" text="Active Auction" />
                <Button onAction="#goToBiddingHistory" styleClass="nav-link" text="Bidding History" />
                <Button onAction="#goToWatchlist" styleClass="nav-link" text="Watchlist" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="15" styleClass="user-section">
                <HBox alignment="CENTER" spacing="12">
                    <Button fx:id="walletBtn" onAction="#goToWallet" styleClass="icon-btn" text="💳" />
                    <StackPane>
                        <Button fx:id="bellBtn" onAction="#onBell" styleClass="icon-btn" text="🔔" />
                        <Label fx:id="notificationBadge" styleClass="badge" text="0" StackPane.alignment="TOP_RIGHT" />
                    </StackPane>
                </HBox>

                <Separator orientation="VERTICAL" prefHeight="20" styleClass="sep" />

                <HBox alignment="CENTER" spacing="8">
                    <Label fx:id="userNameLabel" styleClass="name" text="Guest" />
                    <MenuButton mnemonicParsing="false" styleClass="avatar-menu">
                        <graphic>
                            <Circle fill="#2e8b40" radius="14" />
                        </graphic>
                        <items>
                            <MenuItem onAction="#goToProfile" text="Profile" />
                            <SeparatorMenuItem />
                            <MenuItem onAction="#onLogout" text="Logout" />
                        </items>
                    </MenuButton>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="10" styleClass="main-content">
            <padding>
                <Insets bottom="20" left="24" right="24" top="20" />
            </padding>

            <VBox spacing="10.0" styleClass="form-card" VBox.vgrow="ALWAYS">
                <Label styleClass="card-section-title" text="📦  My Posted Items" />
                <TableView fx:id="postedItemsTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colName" prefWidth="200.0" style="-fx-alignment: CENTER;" text="Item's name" />
                        <TableColumn fx:id="colCategory" prefWidth="180.0" style="-fx-alignment: CENTER;" text="Category" />
                        <TableColumn fx:id="colStartingPrice" prefWidth="180.0" style="-fx-alignment: CENTER;" text="Starting Price" />
                        <TableColumn fx:id="colStatus" prefWidth="180.0" style="-fx-alignment: CENTER;" text="Status" />
                        <TableColumn fx:id="colAuctionId" prefWidth="180.0" style="-fx-alignment: CENTER;" text="Auction ID" />
                    </columns>
                    <placeholder>
                        <Label styleClass="placeholder-label" text="No products yet" />
                    </placeholder>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </center>

</BorderPane>
