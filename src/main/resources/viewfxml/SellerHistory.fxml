<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="bai_tap_lon.client.controller.SellerHistoryController"
            styleClass="root-pane"
            prefWidth="1550"
            prefHeight="900"
            stylesheets="@home-view.css,@style.css">

    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="10" right="25" bottom="10" left="25"/>
            </padding>

            <Label text="BidderHolic" styleClass="logo"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- =========================  ADMIN NAV  ========================= -->
            <HBox fx:id="adminNav" spacing="20" alignment="CENTER" visible="false" managed="false">
                <Button text="Auction List"     styleClass="nav-link"                 onAction="#goToAuctionList"/>
                <Button text="Active Auction"   styleClass="nav-link"                 onAction="#goToActiveAuctions"/>
                <Button text="User Management"  styleClass="nav-link"                 onAction="#goToUserManagement"/>
                <Button text="Auction Approval" styleClass="nav-link"                 onAction="#goToAuctionApproval"/>
                <Button text="Reports"          styleClass="nav-link"                 onAction="#goToReports"/>
                <Button text="System Settings"  styleClass="nav-link"                 onAction="#goToSystemSettings"/>
            </HBox>

            <!-- =========================  SELLER NAV  ======================== -->
            <HBox fx:id="sellerNav" spacing="20" alignment="CENTER" visible="false" managed="false">
                <Button text="Auction List"    styleClass="nav-link"                  onAction="#goToAuctionList"/>
                <Button text="Active Auction"  styleClass="nav-link"                  onAction="#goToActiveAuctions"/>
                <Button text="Selling History" styleClass="nav-link, active-link"/>
                <Button text="Add Item"        styleClass="nav-link"                  onAction="#goToAddItem"/>
            </HBox>

            <!-- =========================  BIDDER NAV  ======================== -->
            <HBox fx:id="bidderNav" spacing="20" alignment="CENTER" visible="false" managed="false">
                <Button text="Auction List"    styleClass="nav-link"                  onAction="#goToAuctionList"/>
                <Button text="Active Auction"  styleClass="nav-link"                  onAction="#goToActiveAuctions"/>
                <Button text="Bidding History" styleClass="nav-link"                  onAction="#goToBiddingHistory"/>
                <Button text="Watchlist"       styleClass="nav-link"                  onAction="#goToWatchlist"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="15" alignment="CENTER_RIGHT" styleClass="user-section">
                <HBox spacing="12" alignment="CENTER">
                    <Button fx:id="walletBtn" text="💳" styleClass="icon-btn" onAction="#goToWallet"/>
                    <StackPane>
                        <Button fx:id="bellBtn" text="🔔" styleClass="icon-btn" onAction="#onBell"/>
                        <Label fx:id="notificationBadge" text="0" styleClass="badge"
                               StackPane.alignment="TOP_RIGHT"/>
                    </StackPane>
                </HBox>

                <Separator orientation="VERTICAL" prefHeight="20" styleClass="sep"/>

                <HBox spacing="8" alignment="CENTER">
                    <Label fx:id="userNameLabel" text="Guest" styleClass="name"/>
                    <MenuButton mnemonicParsing="false" styleClass="avatar-menu">
                        <graphic>
                            <Circle radius="14" fill="#00cda5"/>
                        </graphic>
                        <items>
                            <MenuItem text="Profile" onAction="#goToProfile"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Logout" onAction="#onLogout"/>
                        </items>
                    </MenuButton>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="10" styleClass="main-content">
            <padding>
                <Insets top="20" right="24" bottom="20" left="24"/>
            </padding>

            <VBox spacing="10.0" styleClass="form-card" VBox.vgrow="ALWAYS">
                <children>
                    <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #64FFDA;" text="📦 My Posted Items" />
                    <TableView fx:id="postedItemsTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colName"          prefWidth="200.0" style="-fx-alignment: CENTER;" text="Item's name" />
                            <TableColumn fx:id="colCategory"      prefWidth="180.0" style="-fx-alignment: CENTER;" text="Category" />
                            <TableColumn fx:id="colStartingPrice" prefWidth="180.0" style="-fx-alignment: CENTER;" text="Starting Price" />
                            <TableColumn fx:id="colStatus"        prefWidth="180.0" style="-fx-alignment: CENTER;" text="Status" />
                            <TableColumn fx:id="colAuctionId"     prefWidth="180.0" style="-fx-alignment: CENTER;" text="Auction ID" />
                        </columns>
                        <placeholder>
                            <Label text="No products yet" />
                        </placeholder>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </children>
            </VBox>
        </VBox>
    </center>

</BorderPane>
