<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="306.0" prefWidth="450.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.homepage.HomePageController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <StackPane prefHeight="150.0" prefWidth="200.0">
      <children>
         <ImageView fitHeight="408.0" fitWidth="572.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../../../4028675968ae94377cb57a0cbbd01900.jpg" />
            </image>
         </ImageView>
      
          <Label fx:id="welcomeText" prefHeight="39.0" prefWidth="227.0" text="the best place" textFill="#57a1c3" translateX="-120.0" translateY="-20.0">
            <font>
               <Font name=".VnStamp Normal" size="18.0" />
            </font>
         </Label>
         <Label fx:id="welcomeText1" layoutX="183.0" layoutY="152.0" prefHeight="39.0" prefWidth="252.0" text="to buy and sell!!" textFill="#57a1c3" translateX="-120.0" translateY="20.0">
            <font>
               <Font name=".VnStamp Normal" size="18.0" />
            </font>
         </Label>
         <Button mnemonicParsing="false" onAction="#goToLogin" style="-fx-background-color: #FFFFFF;" text="LOG IN" textFill="#57a1c3" translateX="125.0" translateY="-40.0">
            <font>
               <Font name="Times New Roman Bold" size="20.0" />
            </font>
         </Button>
         <Button layoutX="247.0" layoutY="153.0" mnemonicParsing="false" onAction="#goToSignUp" style="-fx-background-color: #FFFFFF;" text="SIGN UP" textFill="#57a1c3" translateX="125.0" translateY="40.0">
            <font>
               <Font name="Times New Roman Bold" size="20.0" />
            </font>
         </Button>
      </children>
   </StackPane>
</VBox>
