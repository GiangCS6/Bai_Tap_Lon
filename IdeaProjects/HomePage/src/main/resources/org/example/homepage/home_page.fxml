<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.homepage.HomePageController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   //Co giãn được theo size màn hình thực
   <StackPane fx:id="rootStack" VBox.vgrow="ALWAYS">
      <children>
         <ImageView
                 fitHeight="${rootStack.height}"
                 fitWidth="${rootStack.width}"
                 pickOnBounds="true"
                 preserveRatio="false">
            <image>
               <Image url="@../../../4028675968ae94377cb57a0cbbd01900.jpg" />
            </image>
         </ImageView>

         <Label fx:id="welcomeText" prefHeight="39.0" prefWidth="227.0" text="the best place" textFill="#57a1c3" translateX="-120.0" translateY="-20.0">
            <font>
               <Font name=".VnStamp Normal" size="18.0" />
            </font>
         </Label>
         <Label fx:id="welcomeText1" prefHeight="39.0" prefWidth="252.0" text="to buy and sell!!" textFill="#57a1c3" translateX="-120.0" translateY="20.0">
            <font>
               <Font name=".VnStamp Normal" size="18.0" />
            </font>
         </Label>
         <Button mnemonicParsing="false" onAction="#goToLogin" style="-fx-background-color: #FFFFFF;" text="LOG IN" textFill="#57a1c3" translateX="125.0" translateY="-40.0">
            <font>
               <Font name="Times New Roman Bold" size="20.0" />
            </font>
         </Button>
         <Button mnemonicParsing="false" onAction="#goToSignUp" style="-fx-background-color: #FFFFFF;" text="SIGN UP" textFill="#57a1c3" translateX="125.0" translateY="40.0">
            <font>
               <Font name="Times New Roman Bold" size="20.0" />
            </font>
         </Button>
      </children>
   </StackPane>
</VBox>